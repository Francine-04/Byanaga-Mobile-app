{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "userId": {
          ".validate": "newData.isString() && newData.val() === $uid"
        }
      }
    },
    "itineraries": {
      ".indexOn": ["userId"],
      ".read": "auth != null && query.orderByChild === 'userId' && query.equalTo === auth.uid",
      "$itineraryId": {
        ".read": "auth != null && data.child('userId').val() === auth.uid",
        ".write": "auth != null && auth.token.firebase.sign_in_provider !== 'anonymous' && ((!data.exists() && newData.child('userId').val() === auth.uid) || (data.child('userId').val() === auth.uid && (!newData.exists() || newData.child('userId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['userId', 'tripName', 'travelDate', 'status', 'createdAt', 'updatedAt'])"
      }
    }
  }
}
